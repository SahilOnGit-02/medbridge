# Copy to backend/.env for local development. Never commit the real .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://medbridge:medbridge@localhost:5432/medbridge
# Replace locally with a newly generated random secret before running.
JWT_SECRET_KEY=replace-with-a-random-secret
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
ACCOUNT_MAIL_MODE=capture
# Use an absolute private path outside uploads/ and frontend/public/.
ACCOUNT_MAILBOX_DIR=/tmp/medbridge-private-mailbox

# Staging/production: APP_ENV=production, ACCOUNT_MAIL_MODE=smtp,
# PUBLIC_APP_URL=https://your-frontend.example and matching CORS_ORIGINS.
# Credentials belong in the deployment's private environment settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
# Leave omitted until configured; an empty EmailStr is not a valid sender.
# SMTP_PASSWORD=...
# ACCOUNT_MAIL_FROM=verified-sender@your-domain.example
SMTP_TIMEOUT_SECONDS=10
# For implicit TLS use SMTP_SECURITY=ssl and your provider's port, usually 465.
